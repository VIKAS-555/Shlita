{
  "name": "shlita",
  "version": "0.1.0",
  "description": "Shlita (שְׁלִיטָה) — Financial Control Plane & Spending Policy Proxy for Autonomous AI Agents on Solana",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite",
    "build:ui": "vite build && cp -r dist-ui/. dist/ 2>/dev/null || true",
    "build:sdk": "tsc -p packages/sdk/tsconfig.json",
    "build": "tsc -b && tsc -p packages/sdk/tsconfig.json && vite build && (cp -r dist-ui/. dist/ 2>/dev/null || true)",
    "start": "node --import tsx packages/gateway/src/index.ts",
    "test": "vitest run",
    "test:solana-local": "tsx scripts/solana-local-settlement.ts",
    "backup": "tsx packages/gateway/src/backup-cli.ts",
    "restore": "tsx packages/gateway/src/restore-cli.ts",
    "test:watch": "vitest",
    "demo": "tsx demo/run-demo.ts"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "financial-control-plane",
    "circuit-breaker",
    "subscriptions"
  ],
  "author": "XiaoArnav <322868724+XiaoArnav@users.noreply.github.com>",
  "license": "MIT",
  "main": "./packages/core/src/index.ts",
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./gateway": "./packages/gateway/src/index.ts",
    "./solana": "./packages/solana/src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@solana/spl-token": "^0.4.9",
    "@solana/subscriptions": "^0.5.0",
    "@solana/web3.js": "^1.95.8",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.1.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
