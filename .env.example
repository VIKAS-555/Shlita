# Copy to .env and replace every placeholder. Never commit .env.
# Production refuses to start when these values are missing, weak, or published examples.

SHLITA_ENV=development
SHLITA_OPERATOR_KEY=replace-with-at-least-32-random-characters
SHLITA_OPERATOR_ORG=org-example
SHLITA_ALLOW_SIMULATION=false
SHLITA_SEED_DEMO=false
SHLITA_CORS_ORIGINS=http://localhost:5173
SHLITA_DB_PATH=.shlita/ledger.db
SHLITA_STATE_DIR=.shlita
PORT=4000

# Optional. Used only when SHLITA_SEED_DEMO=true outside production.
# Leave unset to generate keys into SHLITA_STATE_DIR/enrollment.json.
# SHLITA_DEMO_KEY_RESEARCHER=
# SHLITA_DEMO_KEY_ARBITRAGE=

# Settlement is off unless both of these are set. The destination is the only
# address the gateway will accept. Do not put a private key in this file.
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet
# SHLITA_SETTLEMENT_ENABLED=false
# SHLITA_SETTLEMENT_DESTINATION=
# Mainnet settlement stays disabled. Do not set SHLITA_ALLOW_MAINNET.
